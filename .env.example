NEBIUS_API_KEY=your_nebius_key_here
TAVILY_API_KEY=your_tavily_key_here
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
NEBIUS_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct

# Langfuse Observability (optional) - Leave blank to run without tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com